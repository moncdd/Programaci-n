Algoritmo Ejercicio09
	Definir dia Como Entero;
	Escribir "Introduce el número del día para saber el día de la semana [1-7]";
	Leer dia;
	Segun dia Hacer
		1: Escribir "Lunes";
		2: Escribir "Martes";
		3: Escribir "Miércoles";
		4: Escribir "Jueves";
		5: Escribir "Viernes";
		6: Escribir "Sábado";
		7: Escribir "Domingo";
		De Otro Modo: Escribir "Día no válido";
	FinSegun
FinAlgoritmo